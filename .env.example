# EventSphere Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# MongoDB Connection String (Optional):
# If provided, the app will connect to your live MongoDB instance or MongoDB Atlas cluster.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventsphere?retryWrites=true&w=majority
# If left empty or omitted, the application uses the built-in local persistent MongoDB document engine (.data/mongodb_store.json).
MONGODB_URI=""

# GEMINI_API_KEY: Optional for AI Studio integrations
GEMINI_API_KEY=""

# APP_URL: The base URL of the application
APP_URL="http://localhost:3000"
